{"chapter_count":3,"chapters":[{"date":"2025-08-10","gallery_mode":"editorial","id":-1,"kind":"chapter","layout":{"image_parallax":false,"mobile_padding":24,"padding":48,"placements":[]},"position":0,"quote":"","reveal":{},"story":"Die Klippen fallen steil zum Atlantik ab. Zwischen den Felsen steht Kandelaber-Wolfsmilch, als gehöre die Hitze ihr allein. Wir sitzen lange am Rand, und das Meer tief unten bewegt sich kaum.","title":"Über dem Meer"},{"date":"","gallery_mode":"editorial","id":-2,"kind":"pair","layout":{"columns":2,"gap":24,"image_parallax":false,"media_width":"cover-frame","mobile_columns":1,"mobile_gap":20,"mobile_padding":24,"padding":48,"parent_id":-1,"placements":[{"edits":{"show_title":true},"id":"showcase-1-0","photo_id":-1},{"edits":{"show_title":true},"id":"showcase-1-1","photo_id":-2}],"ratio":"original","show_title":false},"position":1,"quote":"","reveal":{},"story":"","title":"Auf den Klippen"},{"date":"2025-08-13","gallery_mode":"editorial","id":-3,"kind":"chapter","layout":{"image_parallax":false,"mobile_padding":24,"padding":48,"placements":[]},"position":2,"quote":"","reveal":{},"story":"An der Küste trifft die Brandung auf Lava, die schwarz ist wie gebrannt. Über dem Bergkamm fließen die Wolken ins Tal wie Wasser über eine Kante. Wir bleiben stehen, bis das Licht umschlägt.","title":"Schwarzer Fels, weiße Gischt"},{"date":"","gallery_mode":"editorial","id":-4,"kind":"pair","layout":{"columns":2,"gap":24,"image_parallax":false,"media_width":"cover-frame","mobile_columns":1,"mobile_gap":20,"mobile_padding":24,"padding":48,"parent_id":-3,"placements":[{"edits":{"show_title":true},"id":"showcase-3-2","photo_id":-3},{"edits":{"show_title":true},"id":"showcase-3-3","photo_id":-4}],"ratio":"original","show_title":false},"position":3,"quote":"","reveal":{},"story":"","title":"Küste und Wolken"},{"date":"","gallery_mode":"editorial","id":-5,"kind":"quote","layout":{"image_parallax":false,"mobile_padding":24,"padding":48,"placements":[],"show_title":false,"text_preset":"medium"},"position":4,"quote":"Die Hitze geht zuerst. Das Licht bleibt am längsten.","reveal":{},"story":"","title":"Feldnotiz"},{"date":"2025-08-17","gallery_mode":"horizontal","id":-6,"kind":"chapter","layout":{"image_parallax":false,"mobile_padding":24,"padding":48,"placements":[{"edits":{"show_title":true},"id":"showcase-5-4","photo_id":-5},{"edits":{"show_title":true},"id":"showcase-5-6","photo_id":-7},{"edits":{"show_title":true},"id":"showcase-5-7","photo_id":-8}]},"position":5,"quote":"","reveal":{},"story":"Gegen Abend hängt Staub in der Luft, und die Sonne steht rot über den dunklen Bergen. Im Gegenlicht werden Menschen zu Silhouetten. In einer Höhle rahmt der Fels den Himmel, und draußen fällt der Schatten der Palmen über die Wand.","title":"Calima"},{"date":"","gallery_mode":"editorial","id":-7,"kind":"image","layout":{"image_parallax":false,"media_width":"cover-frame","mobile_padding":24,"padding":48,"placements":[{"edits":{"show_title":true},"id":"showcase-6-5","photo_id":-6}],"show_title":false},"position":6,"quote":"","reveal":{},"story":"","title":"Calima-Sonne"}],"closing":"Am letzten Tag liegt der Schatten der Palmen lang über dem Boden. Wir packen spät. Die Sonne ist schon hinter den Bergen, aber der Himmel bleibt noch eine Weile hell.","country":"Spanien","cover":{"alt":"Die Sonne im Calima-Dunst über dunklen Bergen","chapter_id":null,"credit":"","demo":true,"description":"","featured":false,"height":1467,"id":-6,"large_url":"/WANDER/images/tf-calima-2200.webp","original_url":null,"position":5,"source_url":"","srcset":"/WANDER/images/tf-calima-640.webp 640w, /WANDER/images/tf-calima-1280.webp 1280w, /WANDER/images/tf-calima-2200.webp 2200w","title":"Calima-Sonne","url":"/WANDER/images/tf-calima-1280.webp","width":2200},"cover_focus":null,"cover_id":-6,"demo":true,"description":"Klippen, Lava und Calima. Eine Fotoerzählung über das Licht am Ende heißer Tage.","end_date":"2025-08-19","filmstrip_ids":[],"id":-3,"introduction"
{"chapter_count":3,"chapters":[{"date":"2024-12-27","gallery_mode":"editorial","id":-1,"kind":"chapter","layout":{"image_parallax":false,"mobile_padding":24,"padding":48,"placements":[]},"position":0,"quote":"","reveal":{},"story":"Das Chalet steht im Gegenlicht, das Holz dunkel vor dem Schnee. Wir laden aus und lassen die Taschen im Flur stehen. Am späten Nachmittag geht das Licht in Rot über, und die Gipfel hinter dem Haus brennen kurz auf, bevor es kalt wird.","title":"Ankommen im Schnee"},{"date":"","gallery_mode":"editorial","id":-2,"kind":"pair","layout":{"columns":2,"gap":24,"image_parallax":false,"media_width":"cover-frame","mobile_columns":1,"mobile_gap":20,"mobile_padding":24,"padding":48,"parent_id":-1,"placements":[{"edits":{"show_title":true},"id":"showcase-1-1","photo_id":-2},{"edits":{"show_title":true},"id":"showcase-1-7","photo_id":-8}],"ratio":"original","show_title":false},"position":1,"quote":"","reveal":{},"story":"","title":"Im Gegenlicht"},{"date":"2024-12-29","gallery_mode":"editorial","id":-3,"kind":"chapter","layout":{"image_parallax":false,"mobile_padding":24,"padding":48,"placements":[]},"position":2,"quote":"","reveal":{},"story":"Am See liegt der Dunst so dicht, dass die Berge nur als Schatten dahinter stehen. Ein rostiger Steg führt ein Stück hinaus und hört einfach auf. Weiter oben, am Bach, hat jemand Steine zu einem kleinen Turm gestapelt. Wir gehen vorbei und drehen uns noch einmal um.","title":"Wasser, das nichts verrät"},{"date":"","gallery_mode":"editorial","id":-4,"kind":"pair","layout":{"columns":2,"gap":24,"image_parallax":false,"media_width":"cover-frame","mobile_columns":1,"mobile_gap":20,"mobile_padding":24,"padding":48,"parent_id":-3,"placements":[{"edits":{"show_title":true},"id":"showcase-3-2","photo_id":-3},{"edits":{"show_title":true},"id":"showcase-3-3","photo_id":-4}],"ratio":"original","show_title":false},"position":3,"quote":"","reveal":{},"story":"","title":"Am Wasser"},{"date":"","gallery_mode":"editorial","id":-5,"kind":"quote","layout":{"image_parallax":false,"mobile_padding":24,"padding":48,"placements":[],"show_title":false,"text_preset":"medium"},"position":4,"quote":"Im Schnee wird jedes Geräusch kleiner. Nur das Licht bleibt laut.","reveal":{},"story":"","title":"Feldnotiz"},{"date":"2025-01-01","gallery_mode":"horizontal","id":-6,"kind":"chapter","layout":{"image_parallax":false,"mobile_padding":24,"padding":48,"placements":[{"edits":{"show_title":true},"id":"showcase-5-5","photo_id":-6},{"edits":{"show_title":true},"id":"showcase-5-6","photo_id":-7},{"edits":{"show_title":true},"id":"showcase-5-4","photo_id":-5}]},"position":5,"quote":"","reveal":{},"story":"Am Neujahrstag gehen wir hinauf. Die Hängebrücke spannt sich zwischen zwei verschneiten Gipfeln, und wir überqueren sie langsam, ohne zu reden. Oben öffnet sich die ganze Kette, Kamm hinter Kamm, bis sie im Weiß verschwindet.","title":"Das erste Licht des Jahres"},{"date":"","gallery_mode":"editorial","id":-7,"kind":"image","layout":{"image_parallax":false,"media_width":"cover-frame","mobile_padding":24,"padding":48,"placements":[{"edits":{"show_title":true},"id":"showcase-6-0","photo_id":-1}],"show_title":false},"position":6,"quote":"","reveal":{},"story":"","title":"Alpenpanorama"}],"closing":"Am letzten Abend gehen wir noch einmal zum Kanal. Der Weg führt auf die Berge zu und endet doch nirgends. Morgen fahren wir zurück; das Panorama nehmen wir mit.","country":"Schweiz","cover":{"alt":"Weite Sicht über schneebedeckte Alpengipfel","chapter_id":null,"credit":"","demo":true,"description":"","featured":false,"height":1467,"id":-1,"large_url":"/WANDER/images/ch-panorama-2200.webp","original_url":null,"position":0,"source_url":"","srcset":"/WANDER/images/ch-panorama-640.webp 640w, /WANDER/images/ch-panorama-1280.webp 1280w, /WANDER/images/ch-panorama-2200.webp 2200w","title":"Alpenpanorama","url":"/WANDER/images/ch-panorama-1280.webp","width":2200},"cover_focus":null,"cover_id":-1,"demo":true,"description":"Vom Chalet im Gegenlicht bis zum Panorama am Neujahrstag. Eine Fotoerzählung über den Winter in den Alpen.","end_date":"2025-01-01","filmstrip_ids":[],"id":-3,"introduction":"Wir sind zwischen den Jahren in die Berge gefahren. Es liegt Schnee, die Tage sind kurz, und nach wenigen Stunden im Freien wird das Licht zum eigentlichen Programm. Wir haben nichts vor, außer hinzusehen.","is_example":true,"layout":{"text_animations":false,"title_size":86,"title_style":"overlay"},"location":"Berner Oberland","photo_count":8,"photos":[{"alt":"Weite Sicht über schneebedeckte Alpengipfel","chapter_id":null,"credit":"","demo":true,"description":"","featured":false,"height":1467,"id":-1,"large_url":"/WANDER/images/ch-panorama-2200.webp","original_url":null,"position":0,"source_url":"","srcset":"/WANDER/images/ch-panorama-640.webp 640w, /WANDER/images/ch-panorama-1280.webp 1280w, /WANDER/images/ch-panorama-2200.webp 2200w","title":"Alpenpanorama","url":"/WANDER/images/ch-panorama-1280.webp","width":2200},{"alt":"Ein Holzchalet im Schnee, gegen das Licht fotografiert","chapter_id":null,"credit":"","demo":true,"description":"","featured":false,"height":1467,"id":-2,"large_url":"/WANDER/images/ch-chalet-2200.webp","original_url":null,"position":1,"source_url":"","srcset":"/WANDER/images/ch-chalet-640.webp 640w, /WANDER/images/ch-chalet-1280.webp 1280w, /WANDER/images/ch-chalet-2200.webp 2200w","title":"Chalet im Gegenlicht","url":"/WANDER/images/ch-chalet-1280.webp","width":2200},{"alt":"Ein rostiger Steg in einem stillen See, dahinter Berge im Dunst","chapter_id":null,"credit":"","demo":true,"description":"","featured":false,"height":1467,"id":-3,"large_url":"/WANDER/images/ch-steg-2200.webp","original_url":null,"position":2,"source_url":"","srcset":"/WANDER/images/ch-steg-640.webp 640w, /WANDER/images/ch-steg-1280.webp 1280w, /WANDER/images/ch-steg-2200.webp 2200w","title":"Der Steg","url":"/WANDER/images/ch-steg-1280.webp","width":2200},{"alt":"Ein Steinmännchen an einem Gebirgsbach","
{"chapter_count":3,"chapters":[{"date":"2025-08-10","gallery_mode":"editorial","id":-1,"kind":"chapter","layout":{"image_parallax":false,"mobile_padding":24,"padding":48,"placements":[]},"position":0,"quote":"","reveal":{},"story":"The cliffs drop steeply to the Atlantic. Candelabra spurge stands between the rocks as if the heat belonged to it alone. We sit at the edge for a long time, and the sea far below hardly moves.","title":"Above the sea"},{"date":"","gallery_mode":"editorial","id":-2,"kind":"pair","layout":{"columns":2,"gap":24,"image_parallax":false,"media_width":"cover-frame","mobile_columns":1,"mobile_gap":20,"mobile_padding":24,"padding":48,"parent_id":-1,"placements":[{"edits":{"show_title":true},"id":"showcase-1-0","photo_id":-1},{"edits":{"show_title":true},"id":"showcase-1-1","photo_id":-2}],"ratio":"original","show_title":false},"position":1,"quote":"","reveal":{},"story":"","title":"On the cliffs"},{"date":"2025-08-13","gallery_mode":"editorial","id":-3,"kind":"chapter","layout":{"image_parallax":false,"mobile_padding":24,"padding":48,"placements":[]},"position":2,"quote":"","reveal":{},"story":"On the coast the surf meets lava as black as if it had been burnt. Over the ridge the clouds pour into the valley like water over an edge. We stay until the light turns.","title":"Black rock, white spray"},{"date":"","gallery_mode":"editorial","id":-4,"kind":"pair","layout":{"columns":2,"gap":24,"image_parallax":false,"media_width":"cover-frame","mobile_columns":1,"mobile_gap":20,"mobile_padding":24,"padding":48,"parent_id":-3,"placements":[{"edits":{"show_title":true},"id":"showcase-3-2","photo_id":-3},{"edits":{"show_title":true},"id":"showcase-3-3","photo_id":-4}],"ratio":"original","show_title":false},"position":3,"quote":"","reveal":{},"story":"","title":"Coast and clouds"},{"date":"","gallery_mode":"editorial","id":-5,"kind":"quote","layout":{"image_parallax":false,"mobile_padding":24,"padding":48,"placements":[],"show_title":false,"text_preset":"medium"},"position":4,"quote":"The heat leaves first. The light stays longest.","reveal":{},"story":"","title":"Field note"},{"date":"2025-08-17","gallery_mode":"horizontal","id":-6,"kind":"chapter","layout":{"image_parallax":false,"mobile_padding":24,"padding":48,"placements":[{"edits":{"show_title":true},"id":"showcase-5-4","photo_id":-5},{"edits":{"show_title":true},"id":"showcase-5-6","photo_id":-7},{"edits":{"show_title":true},"id":"showcase-5-7","photo_id":-8}]},"position":5,"quote":"","reveal":{},"story":"Towards evening there is dust in the air, and the sun stands red above dark mountains. Against the light people become silhouettes. In a cave the rock frames the sky, and outside the shadow of the palms falls across the wall.","title":"Calima"},{"date":"","gallery_mode":"editorial","id":-7,"kind":"image","layout":{"image_parallax":false,"media_width":"cover-frame","mobile_padding":24,"padding":48,"placements":[{"edits":{"show_title":true},"id":"showcase-6-5","photo_id":-6}],"show_title":false},"position":6,"quote":"","reveal":{},"story":"","title":"Calima sun"}],"closing":"On the last day the palm shadows lie long on the ground. We pack late. The sun is already behind the mountains, but the sky stays bright a little longer.","country":"Spain","cover":{"alt":"The sun in Calima haze above dark mountains","chapter_id":null,"credit":"","demo":true,"description":"","featured":false,"height":1467,"id":-6,"large_url":"/WANDER/images/tf-calima-2200.webp","original_url":null,"position":5,"source_url":"","srcset":"/WANDER/images/tf-calima-640.webp 640w, /WANDER/images/tf-calima-1280.webp 1280w, /WANDER/images/tf-calima-2200.webp 2200w","title":"Calima sun","url":"/WANDER/images/tf-calima-1280.webp","width":2200},"cover_focus":null,"cover_id":-6,"demo":true,"description":"Cliffs, lava and Calima. A photo essay about the light at the end of hot days.","end_date":"2025-08-19","filmstrip_ids":[],"id":-3,"introduction":"In August Tenerife is hot, bright and sometimes veiled by
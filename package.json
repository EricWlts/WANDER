{
  "name": "wander-editorial-journal",
  "version": "1.0.0",
  "description": "A personal editorial travel journal with React and Flask",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "backend": ".venv/bin/python -m backend.app",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": ".venv/bin/python -m pytest backend/tests -q",
    "test:frontend": "node --experimental-strip-types --test tests/*.test.ts",
    "test:all": "npm run test:frontend && npm test",
    "start": ".venv/bin/python scripts/dev.py",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "e2e:axe": "node scripts/axe-summary.mjs",
    "pages": "PAGES_BASE=/WANDER/ VITE_STATIC=1 vite build --outDir docs --emptyOutDir && PAGES_BASE=/WANDER/ node --experimental-strip-types scripts/export-pages.ts",
    "pages:preview": "vite preview --outDir docs --base /WANDER/ --host 127.0.0.1 --port 4173"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "lucide-react": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.4",
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "private": true
}
